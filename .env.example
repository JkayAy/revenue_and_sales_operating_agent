# App
MOCK_TOOLS=true
PLAYBOOK_CONFIG_PATH=config/playbook.yaml
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql://sales:sales@127.0.0.1:5434/sales_agent
POSTGRES_USER=sales
POSTGRES_PASSWORD=sales
POSTGRES_DB=sales_agent
POSTGRES_HOST_PORT=5434

# HubSpot — private app token and/or OAuth
MOCK_TOOLS=true
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://127.0.0.1:8000/v1/integrations/hubspot/callback

# Optional LLM drafts (also enable flag llm_draft_enabled)
LLM_DRAFT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hardening
RATE_LIMIT_PER_MINUTE=60
OTEL_ENABLED=false

# API
SALES_API_HOST=127.0.0.1
SALES_API_PORT=8000
NEXT_PUBLIC_SALES_API=http://127.0.0.1:8000
